    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.28",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "postcss": "^8.4.38",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.0",
    "vite": "^8.3.0"
