# TMDB API Configuration
# Get your API key at https://www.themoviedb.org/settings/api
MOVIE_DB_URL=https://api.themoviedb.org/3
MOVIE_DB_API_KEY=your_tmdb_api_key_here

# WatchPilot TW research: create .env.local locally and fill your OWN v3 TMDB key.
# Key stays on the Next.js server and must not be committed to GitHub.
# Without a valid key, /lab (Fixture) works; /lab/tw returns an explanatory error.

# WatchPilot decision A/B: Jev is disabled unless you explicitly opt in.
# Set these ONLY in your local .env.local. Do not publish or commit real secrets.
WATCHPILOT_ENABLE_JEV=0
TYPESAFE_API_KEY=
